{
  "name": "rc-garage-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "RC Garage pit-mat SPA — React 18, Vite, Tailwind design tokens, and Zustand auth",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
