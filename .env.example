# RC Garage production environment template.
# Purpose: document every required secret and default so `docker compose`
# boots against loopback-only, non-standard ports without host collisions.
# Copy to `.env` and fill in the required values before deploying.
POSTGRES_DB=rc_garage_prod
POSTGRES_USER=rc_garage_admin
POSTGRES_PASSWORD=change-me-in-production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION=7d
# Optional: promote this email to admin on first auth when no admin exists yet
BOOTSTRAP_ADMIN_EMAIL=
APP_BASE_URL=http://127.0.0.1:3742
# Google reCAPTCHA v2 checkbox. Use real keys on a public host.
# Local/e2e: secret `dev-bypass` plus register token `dev-bypass` skips siteverify.
RECAPTCHA_SECRET_KEY=dev-bypass
VITE_RECAPTCHA_SITE_KEY=dev-bypass
